# Copy to .env for local testing with `netlify dev`. Never commit the real .env file.
# On Netlify, set these under Site configuration -> Environment variables.

# Required for the AI assistant (server-side only. Do NOT prefix with VITE_).
ANTHROPIC_API_KEY=

